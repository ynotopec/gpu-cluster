# Copy this file to .env and edit values for your environment.

# Optional MetalLB range passed to install flow.
METALLB_RANGE=192.168.1.200-192.168.1.220

# Optional cert-manager issuer e-mail.
MAIL_EXPIRE=admin@example.com

# Set to 0/false/no/off to disable letsencrypt-prod ClusterIssuer creation.
ENABLE_LETSENCRYPT=1

# NVIDIA GPU Operator time-slicing replicas per physical GPU.
GPU_TIME_SLICING_REPLICAS=25

# Default profile key from time-slicing-config-fine ConfigMap.
GPU_TIME_SLICING_DEFAULT_PROFILE=any

# Optional default password for add-users workflow.
# USER_PASSWORD=ChangeMeNow!

# Optional timeout (seconds) per `microk8s enable <addon>` call.
# ADDON_ENABLE_TIMEOUT_SECONDS=300
